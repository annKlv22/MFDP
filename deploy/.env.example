# Скопируйте этот файл в .env (Windows: copy .env.example .env) и при желании поправьте значения.

# --- Куда складывать тома Docker (по требованию задания — диск D) ---
HOST_DATA_DIR=D:/mfdp-data

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_USER=birduser
DB_PASS=birdpass
DB_NAME=birds

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rmuser
RABBITMQ_PASS=rmpassword
RABBITMQ_QUEUE=bird_predictions

# --- Хранилище и модель ---
UPLOAD_DIR=/data/uploads
MODEL_DIR=/code/worker/models_store
AST_MODEL_NAME=MIT/ast-finetuned-audioset-10-10-0.4593
DEVICE=cpu

# --- Параметры инференса ---
CONFIDENCE_THRESHOLD=0.4
SEGMENT_SECONDS=5.0
HOP_SECONDS=2.5
TOP_K_STORED=5
MAX_UPLOAD_MB=15
